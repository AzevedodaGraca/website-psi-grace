# Supabase Configuration (Replace with real credentials in production environment)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Server-Only Secret Key (For administrative server operations)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Website Canonical Domain
NEXT_PUBLIC_SITE_URL=https://grcpsi.pt

# Administrator Emails (Comma-separated list of authorized emails for /admin access)
ADMIN_EMAILS=admin@grcpsi.pt,gestao@grcpsi.pt
# Backward-compatible fallback for a single administrator email:
ADMIN_EMAIL=admin@grcpsi.pt

# Email Notification Provider (Resend - Phase 7E.1)
# Server-only API key (never expose to client-side code or browser bundles)
RESEND_API_KEY=
# Sender address/domain verified and authorized by Resend
RESEND_FROM_EMAIL=notificacoes@grcpsi.pt
# Sender display name shown to email recipients
RESEND_FROM_NAME=Psicóloga Grace Azevedo da Graça
# Admin notification recipient email (defaults to gracepsi@hotmail.com if unset)
ADMIN_NOTIFICATION_EMAIL=gracepsi@hotmail.com

# WhatsApp Notification Provider Configuration (Future Phase Integration)
WHATSAPP_API_KEY=your-whatsapp-cloud-api-key
WHATSAPP_PHONE_NUMBER_ID=your-whatsapp-phone-id
