# Supabase Configuration (Replace with real credentials in production environment)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Server-Only Secret Key (For administrative server operations)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Website Canonical Domain
NEXT_PUBLIC_SITE_URL=https://grcpsi.pt

# Optional Administrator Email (Restricts /admin access to this email if set)
ADMIN_EMAIL=admin@grcpsi.pt

# Appointment Notification Foundation (Phase 7D.4)
# Email Notification Provider Configuration (e.g. Resend)
RESEND_API_KEY=your-resend-api-key
NOTIFICATION_FROM_EMAIL=consultas@grcpsi.pt
ADMIN_NOTIFICATION_EMAIL=admin@grcpsi.pt

# WhatsApp Notification Provider Configuration (Future Phase Integration)
WHATSAPP_API_KEY=your-whatsapp-cloud-api-key
WHATSAPP_PHONE_NUMBER_ID=your-whatsapp-phone-id
