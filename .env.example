# Supabase Configuration (Replace with real credentials in production environment)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Server-Only Secret Key (For administrative server operations)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Website Canonical Domain
NEXT_PUBLIC_SITE_URL=https://grcpsi.pt

# Optional Administrator Email (Restricts /admin access to this email if set)
ADMIN_EMAIL=admin@grcpsi.pt
